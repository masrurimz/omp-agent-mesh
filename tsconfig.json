{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/FileSystem",
          "@effect/platform-bun/BunFileSystem",
          "@effect/vitest"
        ]
      }
    ]
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
