{
  "name": "omp-agent-mesh",
  "version": "0.5.0",
  "description": "omp extension that lets separate omp sessions see, message, and coordinate with each other. Own Effect-based mesh engine: repo groups, presence, waking messages, throttled sends, file claims, subagent attribution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/masrurimz/omp-agent-mesh.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write .",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict",
    "typecheck:fast": "bun check --no-script --threads 4",
    "test": "vitest run",
    "smoke": "bun scripts/smoke.ts",
    "check": "bun run lint && bun run fmt && bun run typecheck && bun run typecheck:fast && bun run test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@xstate/effect": "1.0.0-alpha.9",
    "effect": "4.0.6",
    "human-id": "4.2.2",
    "xstate": "6.0.0-alpha.70"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@effect/vitest": "4.0.6",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.4.4",
    "@yielded/effect-tsrs": "0.2.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "ultracite": "8.0.1",
    "vitest": "5.0.5"
  },
  "omp": {
    "extensions": [
      "src/omp/index.ts"
    ]
  }
}
